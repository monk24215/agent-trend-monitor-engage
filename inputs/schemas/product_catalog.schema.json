{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "product_catalog",
  "type": "object",
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "liked_aspects"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "one_liner": { "type": "string" },
          "liked_aspects": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "clickbank": {
            "type": "object",
            "properties": {
              "hoplink": { "type": "string" },
              "vendor_id": { "type": "string" }
            }
          },
          "active": { "type": "boolean" }
        }
      }
    }
  }
}
