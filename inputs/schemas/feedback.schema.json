{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feedback",
  "type": "object",
  "required": ["date", "feedback"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic_id", "outcome"],
        "properties": {
          "topic_id": { "type": "string" },
          "shipped_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "outcome": { "type": "string", "enum": ["good", "neutral", "poor"] },
          "metrics": { "type": "object" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
